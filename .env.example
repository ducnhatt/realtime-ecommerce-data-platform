# Docker Compose
COMPOSE_PROJECT_NAME=realtime-ecommerce

# Kafka local development
KAFKA_IMAGE=apache/kafka:4.2.0
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_HOST_PORT=9092
KAFKA_BROKER=localhost:9092
KAFKA_INTERNAL_BROKER=kafka:29092
KAFKA_TOPIC=ecommerce_reviews
KAFKA_TOPIC_PARTITIONS=10
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=86400000
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_RETRIES=10
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=120000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=30000
SOURCE_TIME_ZONE=Asia/Ho_Chi_Minh

# MinIO Community legacy - local learning only, not for production
MINIO_IMAGE=ghcr.io/coollabsio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a4938f37f1be1841b8e7b627ad0207b265345fd0d063e42d7410c78af0e63e68
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_DLQ_BUCKET=dlq
MINIO_CHECKPOINT_BUCKET=checkpoints
SILVER_OUTPUT_PARTITIONS=1
SILVER_INCREMENTAL_PREFIX=ecommerce_reviews_incremental_v1
SILVER_INCREMENTAL_CHECKPOINT_PREFIX=bronze_to_silver_incremental_v1
SILVER_MAX_FILES_PER_TRIGGER=10
SILVER_INCREMENTAL_OUTPUT_PARTITIONS=2

# Spark standalone local development
SPARK_IMAGE=spark:4.0.4-scala2.13-java17-python3-ubuntu
SPARK_MASTER_HOST_PORT=7077
SPARK_MASTER_UI_HOST_PORT=8080
SPARK_WORKER_UI_HOST_PORT=8081
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=6g
SPARK_CLOUD_PACKAGE=org.apache.spark:spark-hadoop-cloud_2.13:4.0.4
STREAM_TRIGGER_INTERVAL=25 seconds
STREAM_OUTPUT_PARTITIONS=1
KAFKA_MAX_OFFSETS_PER_TRIGGER=10000

# Redis realtime serving - local development only
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_HOST=redis
REDIS_HOST_PORT=6379
REDIS_PORT=6379
REDIS_PASSWORD=redis-local-dev
REDIS_MAXMEMORY=256mb
REDIS_INTERNAL_URL=redis://redis:6379
REDIS_KEY_PREFIX=ecom:rt:v1
REDIS_METRIC_TTL_SECONDS=172800
REDIS_LATEST_LIMIT=100
REDIS_STREAM_TRIGGER_INTERVAL=25 seconds

# ClickHouse analytical warehouse - local development only
CLICKHOUSE_IMAGE=clickhouse:26.3.33.24
CLICKHOUSE_USER=ecommerce
CLICKHOUSE_PASSWORD=ecommerce-local-dev
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9002
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_STAGING_DATABASE=staging
CLICKHOUSE_STAGING_TABLE=ecommerce_events_raw
CLICKHOUSE_STAGING_CHECKPOINT_PREFIX=silver_to_clickhouse_staging_v1
CLICKHOUSE_STAGING_MAX_FILES_PER_TRIGGER=10
CLICKHOUSE_STAGING_OUTPUT_PARTITIONS=2
CLICKHOUSE_CONTROL_DATABASE=control
CLICKHOUSE_GOLD_DATABASE=gold
CLICKHOUSE_SPARK_CONNECTOR_VERSION=0.10.0
CLICKHOUSE_JDBC_VERSION=0.9.5

# dbt runs on the Windows host and publishes first to an isolated dev database
DBT_CLICKHOUSE_HOST=localhost
DBT_CLICKHOUSE_PORT=8123
DBT_TARGET=dev
DBT_CLICKHOUSE_DEV_SCHEMA=gold_dbt_dev
DBT_CLICKHOUSE_PROD_SCHEMA=gold
DBT_THREADS=2

# Airflow orchestration - local runtime with a version-aligned Spark client
AIRFLOW_BASE_IMAGE=apache/airflow:slim-3.3.2-python3.10
AIRFLOW_RUNTIME_IMAGE=realtime-ecommerce-airflow:3.3.2-spark4.0.4
PYSPARK_VERSION=4.0.4
SPARK_HADOOP_CLOUD_PACKAGE=org.apache.spark:spark-hadoop-cloud_2.13:4.0.4
CLICKHOUSE_SPARK_PACKAGE=com.clickhouse.spark:clickhouse-spark-runtime-4.0_2.13:0.10.0
CLICKHOUSE_JDBC_PACKAGE=com.clickhouse:clickhouse-jdbc:0.9.5
AIRFLOW_HOST_PORT=8082
AIRFLOW_PARALLELISM=2
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=1
SPARK_MASTER_URL=spark://spark-master:7077
WAREHOUSE_DAG_SCHEDULE=*/30 * * * *

# Producer output
OUTPUT_FOLDER_NAME=create_data
OUTPUT_FILE_NAME=realtime_reviews.jsonl

# File-based observability v1
MONITORING_HOST_DIR=./monitoring
MONITORING_CONTAINER_DIR=/opt/monitoring
RAW_DATA_MONITOR_FILE=raw_data_monitor.jsonl
BRONZE_MONITOR_FILE=spark_bronze_monitor.jsonl
SILVER_MONITOR_FILE=silver_stream_monitor.jsonl
MONITORING_AGGREGATION_SCHEDULE=*/5 * * * *

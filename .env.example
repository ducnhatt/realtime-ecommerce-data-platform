# Docker Compose
COMPOSE_PROJECT_NAME=realtime-ecommerce

# Kafka local development
KAFKA_IMAGE=apache/kafka:4.2.0
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_HOST_PORT=9092
KAFKA_BROKER=localhost:9092
KAFKA_INTERNAL_BROKER=kafka:29092
KAFKA_TOPIC=ecommerce_reviews
KAFKA_TOPIC_PARTITIONS=10
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=86400000
SOURCE_TIME_ZONE=Asia/Ho_Chi_Minh

# MinIO Community legacy - local learning only, not for production
MINIO_IMAGE=ghcr.io/coollabsio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a4938f37f1be1841b8e7b627ad0207b265345fd0d063e42d7410c78af0e63e68
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ENDPOINT=http://minio:9000
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_DLQ_BUCKET=dlq
MINIO_CHECKPOINT_BUCKET=checkpoints
SILVER_OUTPUT_PARTITIONS=1
SILVER_INCREMENTAL_PREFIX=ecommerce_reviews_incremental_v1
SILVER_INCREMENTAL_CHECKPOINT_PREFIX=bronze_to_silver_incremental_v1
SILVER_MAX_FILES_PER_TRIGGER=10
SILVER_INCREMENTAL_OUTPUT_PARTITIONS=2

# Spark standalone local development
SPARK_IMAGE=spark:4.0.4-scala2.13-java17-python3-ubuntu
SPARK_MASTER_HOST_PORT=7077
SPARK_MASTER_UI_HOST_PORT=8080
SPARK_WORKER_UI_HOST_PORT=8081
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_CLOUD_PACKAGE=org.apache.spark:spark-hadoop-cloud_2.13:4.0.4
STREAM_TRIGGER_INTERVAL=10 seconds
STREAM_OUTPUT_PARTITIONS=1
KAFKA_MAX_OFFSETS_PER_TRIGGER=10000

# Redis realtime serving - local development only
REDIS_IMAGE=redis:8.10.2-alpine
REDIS_HOST=redis
REDIS_HOST_PORT=6379
REDIS_PORT=6379
REDIS_PASSWORD=redis-local-dev
REDIS_MAXMEMORY=256mb
REDIS_INTERNAL_URL=redis://redis:6379
REDIS_KEY_PREFIX=ecom:rt:v1
REDIS_METRIC_TTL_SECONDS=172800
REDIS_LATEST_LIMIT=100
REDIS_STREAM_TRIGGER_INTERVAL=10 seconds

# Producer output
OUTPUT_FOLDER_NAME=create_data
OUTPUT_FILE_NAME=realtime_reviews.jsonl
